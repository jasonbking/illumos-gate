<service_bundle type='manifest' name='lldpd'>

<service
	name='network/lldpd'
	type='service'
	version='0.1'>

	<create_default_instance enabled='false' />

	<single_instance />

	<!-- We currently send (if configured) the hosts management addresses as
	     IP addresses, so we need the IP interfaces configured before we
	     start
	-->

	<dependency
		name='ipmgmt'
		grouping='require_all'
		restart_on='none'
		type='service'>
		<service_fmri value='svc:/network/ip-interface-mgmt' />
	</dependency>

	<exec_method
		type='method'
		name='refresh'
		exec=':kill -HUP'
		timeout_seconds='60'>
	</exec_method>

	<exec_method
		type='method'
		name='start'
		exec='/usr/lib/inet/lldpd'
		timeout_seconds='60'>
	</exec_method>

	<exec_method
		type='method'
		name='stop'
		exec=':kill'
		timeout_seconds='60'>
	</exec_method>

	<property_group name='general' type='framework'>
		<propval name='action_authorization' type='astring'
		  value='solaris.smf.manage.lldp' />
		<propval name='value_authorization' type='astring'
		  value='solaris.smf.manage.lldp' />
	</property_group>

	<property_group name='daemon' type='application'>
		<propval name='log_level' type='count' value='30'
		  override='true'/>
		<propval name='value_authorization' type='astring'
		  value='solaris.smf.manage.lldp' />
	</property_group>

	<property_group name='config' type='application'>
		<propval name='value_authorization' type='astring'
		  value='solaris.smf.manage.lldp' />
	</property_group>

	<!--
	    Default LLDP agent configuration.

	    lldpd has built-in defaults for every agent property. Any
	    property set in this property group replaces the built-in value,
	    and the result is the configuration used by every agent.

	    To override values for a single link, create a property group of
	    type 'agent' named after the link, e.g.:

		svccfg -s network/lldpd addpg igb0 agent
		svccfg -s network/lldpd setprop igb0/admin_status = rx
		svcadm refresh network/lldpd

	    Any property not set in a link's property group retains its
	    default value (from this property group, or built-in).

	    Agent properties (all optional):
		admin_status		astring	disabled | tx | rx | txrx
		port_desc		astring	port description TLV
		tx_tlvs			astring	(list) port-desc sys-name
						sys-desc sys-cap mgmt-addr none
		tx_8021_tlvs		astring	(list) native-vlan vlans
						vlan-name mgmt-vlan none
		tx_8023_tlvs		astring	(list) phy-cfg mtu none
		tx_interval		count	1-3600 (default 30)
		tx_hold_multiplier	count	2-10 (default 4)
		reinit_delay		count	1-10 (default 2)
		tx_credit_max		count	1-10 (default 5)
		tx_fast_interval	count	1-3600 (default 1)
		tx_fast_init		count	1-8 (default 4)
		neighbor_max		count	1-65535 (default 32)
	-->
	<property_group name='default' type='application'>
		<propval name='value_authorization' type='astring'
		  value='solaris.smf.manage.lldp' />
	</property_group>

	<stability value='Unstable' />

	<template>
		<common_name>
			<loctext xml:lang='C'>
				Link layer discovery protocol service
			</loctext>
		</common_name>
		<pg_pattern name='daemon' type='application' target='this'
		   required='false'>
			<common_name>
				<loctext xml:lang='C'>
					lldp daemon startup options
				</loctext>
			</common_name>
			<prop_pattern name='log_level' type='count'
			    required='false'>
				<common_name>
					<loctext xml:lang='C'>
						The log level
					</loctext>
				</common_name>
				<description>
					<loctext xml:lang='C'>
						The minimum log level of events that are logged.
					</loctext>
				</description>
				<cardinality min='1' max='1' />
			</prop_pattern>
		</pg_pattern>
	</template>
</service>
</service_bundle>
