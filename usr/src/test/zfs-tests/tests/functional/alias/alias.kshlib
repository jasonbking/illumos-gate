. $STF_SUITE/include/libtest.shlib
. $STF_SUITE/tests/functional/alias/alias.cfg

#
# Returns success if $TESTZONE is configured.
#
function alias_zone_exists
{
	zoneadm list -c | grep -qx "$TESTZONE"
}

#
# Print the state of $TESTZONE (empty if it is not configured).
#
function alias_zone_state
{
	zoneadm -z $TESTZONE list -p 2>/dev/null | nawk -F: '{ print $3 }'
}

#
# Print the zone ID of $TESTZONE ('-' if it is not running).
#
function alias_zone_id
{
	zoneadm -z $TESTZONE list -p 2>/dev/null | nawk -F: '{ print $1 }'
}

#
# Halt $TESTZONE if it is running.
#
function alias_zone_halt
{
	case $(alias_zone_state) in
	running|ready|shutting_down|down)
		log_must zoneadm -z $TESTZONE halt
		;;
	esac
}

#
# Remove the test zone (halting and uninstalling it as needed) and scratch
# files.
#
function alias_zone_cleanup
{
	if alias_zone_exists; then
		alias_zone_halt
		if [[ $(alias_zone_state) != configured ]]; then
			log_must zoneadm -z $TESTZONE uninstall -F
		fi
		log_must zonecfg -z $TESTZONE delete -F
	fi
	rm -f $ALIAS_CMDFILE $ALIAS_OUTFILE $ALIAS_BOOT_OUT \
	    $ALIAS_INSTALL_LOG
}

#
# Make sure $TESTZONE is installed and halted (see alias.cfg).  If a zone
# cannot be installed on this system, the calling test is reported as
# unsupported.
#
function alias_zone_install
{
	typeset brand

	case $(alias_zone_state) in
	installed)
		return 0
		;;
	running|ready|shutting_down|down)
		alias_zone_halt
		return 0
		;;
	esac

	# Not configured, or left configured/incomplete by an earlier run.
	alias_zone_cleanup

	if ! datasetexists $TESTPOOL/zones; then
		log_must zfs create -o mountpoint=$ZONEROOT $TESTPOOL/zones
	fi
	log_must chmod 700 $ZONEROOT

	alias_cmd_create
	[[ -n $ALIAS_ZONE_BRAND ]] && alias_cmd "set brand=$ALIAS_ZONE_BRAND"
	alias_cmd "set autoboot=false" "commit"
	log_must alias_zonecfg_run

	brand=$(zonecfg -z $TESTZONE info brand | nawk '{ print $2 }')
	log_note "Installing $TESTZONE (brand $brand); this may take a while"
	if ! zoneadm -z $TESTZONE install $ALIAS_ZONE_INSTALL_ARGS \
	    > $ALIAS_INSTALL_LOG 2>&1; then
		cat $ALIAS_INSTALL_LOG
		alias_zone_cleanup
		log_unsupported "Unable to install a $brand zone; set" \
		    "ALIAS_ZONE_BRAND and/or ALIAS_ZONE_INSTALL_ARGS"
	fi

	[[ $(alias_zone_state) == installed ]] || \
	    log_fail "$TESTZONE is not installed after 'zoneadm install'"
}

#
# Halt $TESTZONE and remove its dataset resources, leaving it installed for
# the next test.
#
function alias_zone_reset
{
	alias_zone_exists || return 0
	alias_zone_halt
	if (($(alias_ds_count) > 0)); then
		log_must zonecfg -z $TESTZONE "remove -F dataset"
	fi
}

#
# Wait until $TESTZONE is running and accepts zlogin(1).  If a zone ID is
# given, also wait for the zone to have a different ID (i.e. to have been
# rebooted).
#
function alias_zone_wait
{
	typeset oldid=$1
	typeset -i i=0

	while ((i < ALIAS_BOOT_TIMEOUT)); do
		if [[ $(alias_zone_state) == running &&
		    $(alias_zone_id) != "$oldid" ]] &&
		    zlogin $TESTZONE true > /dev/null 2>&1; then
			return 0
		fi
		sleep 1
		((i += 1))
	done
	log_fail "$TESTZONE not up after $ALIAS_BOOT_TIMEOUT seconds"
}

#
# Boot $TESTZONE and wait for it to come up.  zoneadm output is saved in
# $ALIAS_BOOT_OUT.  Returns non-zero if 'zoneadm boot' fails.
#
function alias_zone_boot
{
	if ! zoneadm -z $TESTZONE boot > $ALIAS_BOOT_OUT 2>&1; then
		cat $ALIAS_BOOT_OUT
		return 1
	fi
	alias_zone_wait
}

#
# Reboot $TESTZONE and wait for it to come back up.
#
function alias_zone_reboot
{
	typeset oldid=$(alias_zone_id)

	log_must zoneadm -z $TESTZONE reboot
	alias_zone_wait $oldid
}

#
# Print the datasets visible inside $TESTZONE, one per line.
#
function alias_zone_datasets
{
	zlogin $TESTZONE zfs list -H -o name -t filesystem,volume
}

#
# Fail unless each argument is a dataset name visible inside $TESTZONE.
#
function alias_zone_visible
{
	typeset list ds

	list=$(alias_zone_datasets) || log_fail "zfs list in $TESTZONE failed"
	for ds in "$@"; do
		if ! print -r -- "$list" | grep -qx "$ds"; then
			print -r -- "$list"
			log_fail "$ds is not visible in $TESTZONE"
		fi
	done
}

#
# Fail if any argument is a dataset name visible inside $TESTZONE.
#
function alias_zone_not_visible
{
	typeset list ds

	list=$(alias_zone_datasets) || log_fail "zfs list in $TESTZONE failed"
	for ds in "$@"; do
		if print -r -- "$list" | grep -qx "$ds"; then
			print -r -- "$list"
			log_fail "$ds is unexpectedly visible in $TESTZONE"
		fi
	done
}

#
# Create datasets to delegate.  zoneadm refuses to delegate a dataset whose
# mountpoint is inherited, so each is given a local mountpoint=none.
#
function alias_create_datasets
{
	typeset ds

	for ds in "$@"; do
		log_must zfs create -p -o mountpoint=none $ds
	done
}

#
# Destroy datasets (and their descendants) created by alias_create_datasets.
#
function alias_destroy_datasets
{
	typeset ds

	for ds in "$@"; do
		datasetexists $ds && log_must zfs destroy -r $ds
	done
}

#
# Start a new zonecfg command file that creates $TESTZONE.
#
function alias_cmd_create
{
	print "create" > $ALIAS_CMDFILE
	print "set zonepath=$ZONEPATH" >> $ALIAS_CMDFILE
}

#
# Start a new (empty) zonecfg command file, for modifying an existing zone.
#
function alias_cmd_begin
{
	: > $ALIAS_CMDFILE
}

#
# Append arbitrary zonecfg commands (one per argument) to the command file.
#
function alias_cmd
{
	typeset line

	for line in "$@"; do
		print -r -- "$line" >> $ALIAS_CMDFILE
	done
}

#
# Append an 'add dataset' resource.
#	$1	dataset name
#	$2	alias (optional)
#
function alias_cmd_add_ds
{
	typeset name=$1
	typeset alias=$2

	alias_cmd "add dataset" "set name=$name"
	[[ -n $alias ]] && alias_cmd "set alias=\"$alias\""
	alias_cmd "end"
}

#
# Run zonecfg against $TESTZONE with the current command file.  Combined
# stdout/stderr is saved in $ALIAS_OUTFILE.  Returns the zonecfg exit status.
#
function alias_zonecfg_run
{
	typeset -i ret

	zonecfg -z $TESTZONE -f $ALIAS_CMDFILE > $ALIAS_OUTFILE 2>&1
	ret=$?
	if ((ret != 0)); then
		log_note "zonecfg exited $ret, commands:"
		cat $ALIAS_CMDFILE
		log_note "zonecfg output:"
		cat $ALIAS_OUTFILE
	fi
	return $ret
}

#
# Print the number of dataset resources configured for $TESTZONE.
# Optional arguments are passed through as property filters,
# e.g. 'alias_ds_count alias=foo'.
#
function alias_ds_count
{
	zonecfg -z $TESTZONE info dataset "$@" | grep -c '^dataset:'
}

#
# Print the alias configured for the dataset named $1 (empty if none).
#
function alias_ds_alias
{
	zonecfg -z $TESTZONE info dataset name=$1 | \
	    nawk '$1 == "alias:" { sub(/^[ \t]*alias: /, ""); print }' | \
	    sed -e 's/^"//' -e 's/"$//'
}

#
# Print the name of the dataset whose alias is $1 (empty if none).
#
function alias_ds_name
{
	zonecfg -z $TESTZONE info dataset alias="$1" | \
	    nawk '$1 == "name:" { print $2 }'
}

#
# Verify the dataset named $1 has alias $2 (or no alias if $2 is empty).
#
function alias_verify_ds
{
	typeset name=$1
	typeset expected=$2
	typeset actual

	actual=$(alias_ds_alias $name)
	if [[ "$actual" != "$expected" ]]; then
		zonecfg -z $TESTZONE info dataset
		log_fail "dataset $name: expected alias '$expected'," \
		    "got '$actual'"
	fi

	if [[ -z $expected ]]; then
		zonecfg -z $TESTZONE info dataset name=$name | \
		    grep -q 'alias not specified' || \
		    log_fail "dataset $name: 'alias not specified' not shown"
	fi
}

#
# Verify $ALIAS_OUTFILE mentions the given (invalid) alias.
#
function alias_verify_invalid_msg
{
	typeset alias=$1

	grep -F "alias '$alias' invalid" $ALIAS_OUTFILE > /dev/null || \
	    log_fail "expected 'alias '$alias' invalid' in zonecfg output"
}
