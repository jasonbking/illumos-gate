set name=pkg.fmri value=pkg:/system/storage/mfiutil@$(PKGVERS)
set name=pkg.summary value="LSI MegaRAID SAS HBA management utility"
set name=pkg.description value="LSI MegaRAID SAS HBA management utility"
set name=info.classification value=org.opensolaris.category.2008:System/Hardware
set name=variant.arch value=$(ARCH)
dir  path=usr group=sys
dir  path=usr/sbin
hardlink path=usr/sbin/lmrcutil target=mfiutil variant.opensolaris.zone=global
file path=usr/sbin/mfiutil mode=0555 variant.opensolaris.zone=global
hardlink path=usr/sbin/mrsasutil target=mfiutil variant.opensolaris.zone=global
dir  path=usr/share/man/man8
link path=usr/share/man/man8/lmrcutil.8 target=mfiutil.8
file path=usr/share/man/man8/mfiutil.8
link path=usr/share/man/man8/mrsasutil.8 target=mfiutil.8
license usr/src/cmd/mfiutil/THIRDPARTYLICENSE \
    license=usr/src/cmd/mfiutil/THIRDPARTYLICENSE
